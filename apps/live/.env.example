# Adresse publique du site (liens dans les e-mails)
APP_URL="https://pelify.app"

# Obligatoire en production : au moins 16 caractères aléatoires
SESSION_SECRET="remplacez-par-une-longue-valeur-aleatoire"

# Adresses e-mail des administrateurs (modération), séparées par des virgules
ADMIN_EMAILS=""

# Données (sans cette variable, les données restent en mémoire, pour le développement seulement)
DATABASE_URL=""

# Envoi des codes et des notifications par e-mail (un seul fournisseur suffit)
RESEND_API_KEY=""
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_EMAIL="notifications@pelify.app"
MAIL_FROM_NAME="PELIFY Arena"

# Envoi facultatif des codes par SMS et WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_OTP_CONTENT_SID=""
DEFAULT_COUNTRY_CODE="33"
